# Sao chép thành .env để chạy local (vercel dev). KHÔNG commit file .env.
# Trên Vercel: Project > Settings > Environment Variables.

# GitHub (token chỉ cần quyền Contents: Read and write cho đúng 1 repo)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=qr-hub
GITHUB_BRANCH=main

# Khoá quản trị (thay cho pass 0000 trong config.js). Dùng chuỗi dài, ngẫu nhiên.
ADMIN_KEY=

# Khoá mã hoá số tài khoản/tên chủ TK trong data/config.json. ĐỪNG ĐỔI sau khi đã lưu dữ liệu.
DATA_KEY=

# Muối để băm IP trong log
LOG_SALT=

# Giao diện (không nhạy cảm)
APP_TITLE=QR Hub
APP_COLOR=#6366f1
